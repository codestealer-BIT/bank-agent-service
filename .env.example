# Copy this file to .env. Never commit the real key.
LITELLM_BASE_URL=https://your-internal-litellm.example/v1
LITELLM_API_KEY=replace-me
LITELLM_MODEL=MiniMax-M3

POSTGRES_PASSWORD=replace-with-a-long-random-password
MAX_GLOBAL_TURNS=32
TURN_QUEUE_TIMEOUT_MS=120000
TURN_LEASE_MS=600000
LETTA_REQUEST_TIMEOUT_MS=600000
MEMORY_REFLECTION_ENABLED=true
MEMORY_REFLECTION_POLL_MS=300000
MEMORY_REFLECTION_BATCH_SIZE=12
CORS_ORIGINS=http://localhost:8080

# Local demo login only. Production must use bank SSO/OIDC and COOKIE_SECURE=true.
DEMO_AUTH_ENABLED=true
DEMO_USER_PASSWORD=replace-with-a-strong-demo-password
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# QQ 邮箱 SMTP。SMTP_AUTH_CODE 必须填写 QQ 邮箱生成的 16 位授权码，
# 不能填写 QQ 登录密码。收件人固定在后端，智能体无法自行更改。
SMTP_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@qq.com
SMTP_AUTH_CODE=replace-with-qq-authorization-code
SMTP_DEFAULT_TO=operations-recipient@example.com
SMTP_FROM_NAME=澄川智能运维助手
