# Copy this file to .env. Never commit the real key.
LITELLM_BASE_URL=https://your-internal-litellm.example/v1
LITELLM_API_KEY=replace-me
LITELLM_MODEL=MiniMax-M3
# Ordered fallbacks. MiniMax is tried twice; fallback models are tried once each.
LITELLM_FALLBACK_MODELS=Kimi-K3,GLM-5.2,Kimi-K2.7-Code
# The repository-local LiteLLM proxy forwards to the URL/key above and exports
# model traces, including prompts and responses, to this Langfuse project.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_HOST=https://cloud.langfuse.com
AGENT_PRIMARY_ATTEMPTS=2
AGENT_FALLBACK_ATTEMPTS=1
AGENT_FAILOVER_BACKOFF_BASE_MS=500
AGENT_FAILOVER_BACKOFF_MAX_MS=8000

POSTGRES_PASSWORD=replace-with-a-long-random-password
MAX_GLOBAL_TURNS=32
TURN_QUEUE_TIMEOUT_MS=120000
TURN_LEASE_MS=600000
LETTA_REQUEST_TIMEOUT_MS=600000
# Compact active Letta conversation history before it approaches a 1 MiB proxy limit.
# Set to 0 to disable proactive byte-based compaction.
LETTA_COMPACTION_THRESHOLD_BYTES=700000
MEMORY_REFLECTION_ENABLED=true
MEMORY_REFLECTION_POLL_MS=300000
MEMORY_REFLECTION_BATCH_SIZE=12

# Minute-level infrastructure demo simulation and transition-only alert mail.
# 0.04 means about 1.2 newly affected machines per 30 minutes on average.
INFRA_MONITOR_ENABLED=true
INFRA_MONITOR_INTERVAL_MS=60000
INFRA_INCIDENT_CHANCE_PER_MINUTE=0.04
INFRA_MULTIPLE_INCIDENT_CHANCE=0.12
INFRA_MAX_ACTIVE_INCIDENTS=2
# New events inside this window are merged into the next message.
INFRA_ALERT_EMAIL_COOLDOWN_MS=900000
INFRA_ALERT_RECIPIENT=813624374@qq.com
INFRA_ALERT_USER_ID=demo-user-a

# Local semantic RAG. The default Docker Compose service runs BGE-M3 locally;
# leave the API key empty. Point this URL at an OpenAI-compatible embedding
# provider only when the bank has approved an external embedding service.
RAG_EMBEDDING_BASE_URL=http://embeddings:80
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_TIMEOUT_MS=60000
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=180
RAG_MIN_SIMILARITY=0.42
CORS_ORIGINS=http://localhost:8080

# Local demo login only. Production must use bank SSO/OIDC and COOKIE_SECURE=true.
DEMO_AUTH_ENABLED=true
DEMO_USER_A_PASSWORD=replace-with-a-strong-password-for-user-a
DEMO_USER_A_EMAIL=first-user@qq.com
DEMO_USER_A_PHONE=13800001001
DEMO_USER_B_PASSWORD=replace-with-a-strong-password-for-user-b
DEMO_USER_B_EMAIL=2113950574@qq.com
DEMO_USER_B_PHONE=13800001002
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# 兼容旧配置：启动迁移会将这里的 SMTP 用户和授权码绑定到 User A。
# 新授权码也可在“每日运维邮件”表单中按当前登录用户安全保存。
SMTP_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@qq.com
SMTP_AUTH_CODE=replace-with-qq-authorization-code
SMTP_DEFAULT_TO=operations-recipient@example.com
SMTP_FROM_NAME=澄川智能运维助手
